  "about_title": {
    "message": "about"
  },
  "about_what": {
    "message": "Hi, I'm Lucas. I built auracore so I could hear any song as slowed + reverb, nightcore or lo-fi without waiting for someone to upload that version."
  },
  "about_how": {
    "message": "The effect plays only on the tab where you turned it on, and everything happens in your browser. Nothing you listen to is recorded or sent anywhere."
  },
  "about_capture": {
    "message": "On Spotify and Amazon Music, Chrome shows a tab capture notice while the effect is on. That is how the effect reaches those songs."
  },
  "about_version": {
    "message": "version $VERSION$",
    "placeholders": {
      "version": {
        "content": "$1",
        "example": "0.9.0"
      }
    }
  },
  "support_title": {
    "message": "buy me a coffee?"
  },
  "support_intro": {
    "message": "auracore is free and will stay that way. I build it in my spare time, between work and college."
  },
  "support_kind": {
    "message": "If it's been playing along with your music, how about buying me a coffee? Any amount helps and keeps me going."
  },
  "support_alternative": {
    "message": "If you can't, no worries: telling a friend or leaving a star on GitHub already makes my day."
  },
